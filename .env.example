# Notion API Configuration
# Create an integration at https://www.notion.so/my-integrations
# and share your Team DB and Products DB with the integration.

NOTION_TOKEN=secret_your_notion_integration_token_here
NOTION_MEMBER_DB_ID=your_member_database_id_here
NOTION_PRODUCTS_DB_ID=your_products_database_id_here
NOTION_MESSAGES_DB_ID=your_messages_database_id_here

# Auth Session Secret (Optional - defaults to built-in development secret)
AUTH_SECRET=your_random_32_char_secret_key_here
